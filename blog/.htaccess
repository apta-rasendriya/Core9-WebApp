# This folder is meant to be dropped in as a subfolder of another site
# (e.g. yoursite.com/blog/), so unlike a dedicated docroot it can't rely on
# files simply being "outside the webroot" for protection. Block dotfiles
# (.env, .gitignore, .htaccess itself) from ever being served directly.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Compress text responses (pages, CSS, JS, SVG).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain image/svg+xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
</IfModule>

# Browser caching. CSS/JS/logos are linked with ?v=<file time>, and uploaded
# images get a new random name on every upload, so both can be kept long.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|webp|jpe?g|png|gif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
