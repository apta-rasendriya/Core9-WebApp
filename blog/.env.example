# Copy this file to .env and fill in your real values.
# .env is git-ignored so credentials never get committed.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=core9_blog
DB_USER=core9
DB_PASS=change-me

# Optional: email address notified about each new toolkit lead (blank = no email).
# Needs a working PHP mail() setup on the server.
LEAD_NOTIFY_EMAIL=

# Optional: the main site address (default https://core9.ai), for link previews.
SITE_URL=
